function saveSelectedProducts(){const missing=mandateReadiness();if(missing.length){alert('Complete the lead information before proceeding to the mandate process.\n\nMissing: '+missing.join(', '));return;}const s=window.selectedProducts||{};if(!Object.keys(s).some(k=>['debt_review','credit_assessment','judgement_adverse','debt_mediation','prepaid_legal','credit_score_booster'].includes(k))){alert('Please select at least one product.');return;}if(s.debt_mediation && (!s.debt_mediation_monthly||!s.debt_mediation_months)){alert('Please enter the monthly payment and number of months for Debt Mediation.');return;}window.mandateRead=false;window.creditCheckAuth=false;window.attorneyAuth=false;mandateView();}

