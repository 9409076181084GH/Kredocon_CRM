function isoToday(){return new Date().toISOString().slice(0,10)}
function defaultPaymentDate(){const d=new Date();return d.toISOString().slice(0,10)}
function money(n){return 'R'+Number(n||0).toLocaleString('en-ZA',{minimumFractionDigits:2,maximumFractionDigits:2})}
function addMonths(dateStr,n){const d=new Date(dateStr+'T12:00:00');d.setMonth(d.getMonth()+Number(n||0));return d.toISOString().slice(0,10)}
function auxDueStatus(start){return start<=isoToday()?'Due':'Scheduled'}
function paymentDateForMonth(baseDate,paymentDay,offset){
const base=new Date(baseDate+'T12:00:00');
const d=new Date(base.getFullYear(),base.getMonth()+Number(offset||0),1,12,0,0);
const day=Math.min(Number(paymentDay)||25,new Date(d.getFullYear(),d.getMonth()+1,0).getDate());
return new Date(d.getFullYear(),d.getMonth(),day,12,0,0).toISOString().slice(0,10);
}
function buildPaymentSchedule(r){
const count=r.term===''||Number(r.term)<=0?12:Number(r.term);
const amount=Number(r.term)==1?Number(r.totalValue||0):Number(r.monthlyAmount||0);
const schedule=[];
for(let i=0;i<count;i++){
 const dueDate=i===0?r.startDate:paymentDateForMonth(r.startDate,r.paymentDay,i);
 schedule.push({installment:i+1,amount:amount,dueDate,status:dueDate<=isoToday()?'Due':'Scheduled',paid:false,paidDate:''});
}
return schedule;
}
function scheduleSummary(r){
const s=r.paymentSchedule||[];
if(!s.length)return '<div class="small">Payment schedule will be created after mandate approval.</div>';
const next=s.find(x=>!x.paid);
return `<div class="small">${s.length>=12&&r.term===''?'Monthly schedule':'Installments: '+s.length} · ${s.filter(x=>x.paid).length} paid · ${next?'Next due '+next.dueDate:'Completed'}</div>`;
}
