function show(type, pushHistory=true){
  const routes={dashboard:dash,leads:leadsView,converted:convertedView,clients:clientsView,sales:salesView,activities:activitiesView,documents:documentsView,payments:paymentsView,mandates:mandatesTrackingView,services:servicesView,reports:reportsView,admin:adminView,products:productSelectionView,mandate:mandateView};
  if(typeof routes[type]!=='function') type='dashboard';
  const previous=window.currentPage||'dashboard';
  try { routes[type](); } catch(err) { console.error('Navigation error:',err); return; }
  window.currentPage=type;
  const back=document.getElementById('backBtn');
  if(back) back.classList.toggle('show',type!=='dashboard');
  if(pushHistory && previous!==type){
    window.pageStack=window.pageStack||['dashboard'];
    if(window.pageStack[window.pageStack.length-1]!==type) window.pageStack.push(type);
    history.pushState({page:type},'', '#'+type);
  }
}
function goBackFromPage(){
  const stack=window.pageStack||['dashboard'];
  if(stack.length>1){
    stack.pop();
    const target=stack[stack.length-1]||'dashboard';
    window.pageStack=stack;
    show(target,false);
    history.replaceState({page:target},'', '#'+target);
  } else {
    show('dashboard',false);
    history.replaceState({page:'dashboard'},'', '#dashboard');
  }
}
window.addEventListener('popstate',function(e){
  const page=(e.state&&e.state.page)||location.hash.replace('#','')||'dashboard';
  const stack=window.pageStack||['dashboard'];
  if(stack[stack.length-1]!==page){
    const idx=stack.lastIndexOf(page);
    window.pageStack=idx>=0?stack.slice(0,idx+1):['dashboard',page];
  }
  show(page,false);
});
