<script>
window.supabaseReady = false;
window.supabaseClient = null;
function getSupaConfig(){
  // 1. Hardcoded
  if(window.KREDOCON_SUPABASE_URL && window.KREDOCON_SUPABASE_ANON_KEY) return {url: window.KREDOCON_SUPABASE_URL, key: window.KREDOCON_SUPABASE_ANON_KEY};
  // 2. localStorage saved
  const url = localStorage.getItem('pcs_supabase_url');
  const key = localStorage.getItem('pcs_supabase_key');
  if(url && key) return {url, key};
  return null;
}
async function initSupabaseOneFile(){
  const badge = document.getElementById('supa-badge');
  const cfg = getSupaConfig();
  if(!cfg){
    if(badge){ badge.textContent = '● Click to Connect Supabase'; badge.style.background = '#f59e0b'; badge.style.cursor='pointer'; badge.onclick = () => openSupaSetup(); }
    return;
  }
  try{
    window.supabaseClient = window.supabase.createClient(cfg.url, cfg.key);
    window.supabaseReady = true;
    if(badge){ badge.textContent = '● Connected to Supabase'; badge.style.background = '#10b981'; }
    console.log('✅ Supabase connected (one-file)', cfg.url);
  }catch(e){ console.error(e); if(badge){ badge.textContent = '● Connection Failed'; badge.style.background = '#ef4444'; } }
}
function openSupaSetup(){
  const url = prompt('Paste your Supabase Project URL (from Supabase Dashboard > Settings > API):\n e.g. https://abcdefgh.supabase.co');
  if(!url) return;
  const key = prompt('Paste your Supabase ANON KEY (same page, anon public key - long eyJ... string):');
  if(!key) return;
  localStorage.setItem('pcs_supabase_url', url);
  localStorage.setItem('pcs_supabase_key', key);
  location.reload();
}
window.saveLeadToSupabase = async function(leadObj){
  if(!window.supabaseClient) return {ok:false};
  try{ const {data, error} = await window.supabaseClient.from('leads').upsert(leadObj).select(); if(error) throw error; return {ok:true, data}; }catch(e){ return {ok:false, error:e.message}; }
}
document.addEventListener('DOMContentLoaded', initSupabaseOneFile);
</script>

